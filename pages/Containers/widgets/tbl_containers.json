  "tableData": "{{(((d) => { try { return (typeof d === 'string' ? JSON.parse(d) : d) || {}; } catch(e) { return {}; } })(GetContainers.data).containers || []).filter(c => { const q = (inp_search.text || '').toLowerCase(); if (!q) return true; const sup = (c.container_suppliers || []).map(s => s.supplier_name).join(' '); return [c.container_number, c.customer_name, c.status, c.carrier, sup].join(' ').toLowerCase().includes(q); }).map(c => { const sups = (c.container_suppliers || []).slice().sort((a,b) => new Date(a.created_at) - new Date(b.created_at)); const supDisplay = sups.length === 0 ? (c.shipper_name || '—') : (sups[0].supplier_name + (sups.length > 1 ? ' (+' + (sups.length - 1) + ')' : '')); const fd = c.port_free_days_end ? Math.ceil((new Date(c.port_free_days_end) - new Date()) / 86400000) : null; return { 'מכולה': c.container_number, 'ספק/משלח': supDisplay, 'סטטוס': c.status, 'ETA': c.eta ? moment(c.eta).format('DD/MM') : '—', 'ימים חופשיים': fd === null ? '—' : (fd + ' ימים'), id: c.id }; })}}",
