  "rightColumn": 40,
  "tableData": "{{(() => { const c=(CDContainerDetail.data && CDContainerDetail.data.container)||{}; const sups=(c.container_suppliers||[]).slice().sort((a,b)=>new Date(a.created_at)-new Date(b.created_at)); const docs=(CDDocumentsList.data&&CDDocumentsList.data.documents)||[]; return sups.map(s=>({supplier_name:s.supplier_name, items_count:s.items_count||0, documents:docs.filter(d=>d.supplier_id===s.id).map(d=>d.doc_type).join(', ')||'—'})); })()}}",
